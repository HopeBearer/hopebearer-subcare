// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  USER
  ADMIN
}

// AI Provider model fetch strategy
enum ModelFetchStrategy {
  DYNAMIC  // Requires user API Key to fetch models (OpenAI, DeepSeek)
  PUBLIC   // Public API, can be cached server-side (OpenRouter)
  MANUAL   // Manually maintained by admin (Anthropic, private deployments)
}

// AI Provider API format
enum ApiFormat {
  OPENAI     // OpenAI-compatible API
  ANTHROPIC  // Anthropic API format
  CUSTOM     // Custom format (requires adapter)
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  refreshToken String?  @db.Text
  bio       String?  @db.Text
  
  // User settings
  currency      String  @default("CNY")
  monthlyBudget Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  
  subscriptions Subscription[]
  notifications Notification[]
  notificationSettings NotificationSetting[]
  paymentRecords PaymentRecord[]
  categories    Category[]
  aiConfigs     UserAIConfig[]
  aiRecommendation AIRecommendation?
  conversations Conversation[]
  systemLogs    SystemLog[]

  @@map("users")
}

model Subscription {
  id          String   @id @default(uuid())
  name        String
  normalizedName String @default("") // Normalized name for duplicate detection (lowercase, trimmed)
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("CNY")
  billingCycle String  // monthly, yearly, weekly, daily
  startDate   DateTime
  nextPayment DateTime?
  status      String   @default("ACTIVE") // ACTIVE, CANCELLED, PAUSED
  
  // Category relation
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  // Keep old string for backward compatibility if needed, or migration strategy. 
  // Ideally this would be deprecated. Using @map to keep column name if needed but for new logic:
  categoryName    String   @default("Other") @map("category") // Remapped old column to avoid conflict if we want to keep data, or we can just drop it. Let's keep it as `categoryName` but map to `category` column to preserve data if user doesn't migrate column. 
  // Wait, if I change the model field `category` to `categoryName`, existing code might break.
  // The user asked to "extract Category model".
  // Let's keep `category` string for now to avoid breaking too much frontend code immediately, 
  // but add `categoryId` for the new relation.
  // Actually, let's just add `categoryId` and `category` relation. 
  // The existing `category` string field will remain as legacy/fallback.

  icon        String?  // Optional icon identifier or url
  description String?  @db.Text
  
  // New fields from frontend requirements
  paymentMethod      String?
  autoRenewal        Boolean  @default(true)
  enableNotification Boolean  @default(false)
  notifyDaysBefore   Int?
  website            String?
  notes              String?  @db.Text
  usage              String   @default("Normally")

  // Historical spending (user-provided, not system-tracked)
  historicalSpending  Decimal? @db.Decimal(10, 2) // User's self-reported total spending before system tracking
  historicalNote      String?  @db.Text            // Optional note about historical spending context

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  paymentRecords PaymentRecord[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([categoryId])
  @@index([userId, normalizedName])
  @@map("subscriptions")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  icon        String?
  color       String?  @default("#94a3b8")
  budgetLimit Decimal? @db.Decimal(10, 2)
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  subscriptions Subscription[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@map("categories")
}

model PaymentRecord {
  id              String   @id @default(uuid())
  
  amount          Decimal  @db.Decimal(10, 2)
  currency        String
  exchangeRate    Decimal? @db.Decimal(10, 4)
  
  billingDate     DateTime
  periodStart     DateTime?
  periodEnd       DateTime?
  
  status          String   @default("PAID") // PAID, PENDING, FAILED, REFUNDED
  note            String?  @db.Text

  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([userId, billingDate])
  @@index([subscriptionId])
  @@map("payment_records")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   @db.Text
  type      String   // system / billing / security / marketing
  isRead    Boolean  @default(false)

  // i18n support
  key       String?  // Translation key (e.g. "notification.welcome")
  data      Json?    // Translation params (e.g. { "name": "User" })
  
  // Extended fields for rich UI and interaction
  link        String?
  metadata    Json?
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  actionLabel String?

  createdAt DateTime @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// User Notification Settings
model NotificationSetting {
  id        String   @id @default(uuid())
  userId    String
  
  // Notification Key: Can be Category ('billing') or Event ('billing.renewal')
  key       String   
  
  // Channel switches
  email     Boolean  @default(true)
  inApp     Boolean  @default(true) // Includes Web Socket push

  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@map("notification_settings")
}

model SystemLog {
  id        String   @id @default(uuid())

  level     String   // DEBUG | INFO | WARN | ERROR | AUDIT
  domain    String   // AUTH | API | EMAIL | NOTIFICATION | PAYMENT | SYSTEM
  action    String   // login | send_email | create_subscription

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ip        String?
  requestId String?

  metadata  Json?
  error     String?  @db.Text

  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([domain])
  @@index([level])
  @@index([userId])
  @@map("system_logs")
}

model MessageTemplate {
  id       String @id @default(uuid())

  key      String @unique  // reset-password / subscription-expire
  title    String
  content  String @db.Text  // HTML or Markdown
  channel  String          // email / in-app
  
  deletedAt DateTime?

  @@map("message_templates")
}

model UserAIConfig {
  id        String   @id @default(uuid())
  userId    String
  
  // Legacy field for backward compatibility
  provider  String   // "openai", "deepseek", "anthropic", "openrouter"
  
  // New relation to AIProvider (optional for migration)
  providerId String?
  aiProvider AIProvider? @relation(fields: [providerId], references: [id])
  
  apiKey    String   @db.Text // Encrypted
  model     String?  // e.g. "gpt-4-turbo", "deepseek-chat"
  baseUrl   String?  // Optional: for custom proxies or local LLMs
  
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Add this for soft-delete compatibility
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([providerId])
  @@map("user_ai_configs")
}

model AIRecommendation {
  id        String   @id @default(uuid())
  userId    String
  content   Json     // Stores the full recommendation JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("ai_recommendations")
}


model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique // Hashed token
  expiresAt DateTime
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@map("password_reset_tokens")
}

model ExchangeRate {
  id        String   @id @default(uuid())
  currency  String   @unique // 'USD', 'CNY', etc.
  rate      Decimal  @db.Decimal(20, 10) // Rate relative to EUR, increased precision for weak currencies
  base      String   @default("EUR")
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  
  @@map("exchange_rates")
}

// =====================
// AI Provider & Model
// =====================

model AIProvider {
  id          String   @id @default(uuid())
  
  name        String   // "OpenAI", "OpenRouter", "DeepSeek"
  slug        String   @unique // "openai", "openrouter", "deepseek"
  
  baseUrl     String   // API base URL: "https://api.openai.com/v1"
  modelsUrl   String?  // URL to fetch models list (optional)
  
  logoUrl     String?  // Provider logo URL
  description String?  @db.Text
  website     String?  // Official website
  
  // Model fetching strategy
  modelFetchStrategy ModelFetchStrategy @default(DYNAMIC)
  
  // API format/compatibility
  apiFormat   ApiFormat @default(OPENAI)
  
  isBuiltIn   Boolean  @default(false)  // Whether this is a built-in provider
  isActive    Boolean  @default(true)   // Whether enabled
  sortOrder   Int      @default(0)      // Display order
  
  models      AIModel[]
  userConfigs UserAIConfig[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  @@map("ai_providers")
}

// Model data source
enum ModelSource {
  MANUAL  // Manually added by admin
  API     // Synced from provider API
}

model AIModel {
  id              String   @id @default(uuid())
  
  // Basic info
  modelId         String   // Original ID: "gpt-4o", "claude-3-opus-20240229"
  name            String   // Display name
  description     String?  @db.Text
  
  // Provider relation
  providerId      String
  provider        AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  // Model source (how it was added)
  source          ModelSource @default(MANUAL)
  
  // Capabilities
  contextLength   Int?
  maxTokens       Int?
  inputModalities Json?    // ["text", "image"]
  outputModalities Json?   // ["text"]
  
  // Pricing (per million tokens, stored as string for precision)
  pricingPrompt      String?  // Input price per million tokens
  pricingCompletion  String?  // Output price per million tokens
  pricingCurrency    String   @default("USD")
  
  // Supported parameters
  supportedParams Json?    // ["temperature", "top_p", "tools", ...]
  
  // Status
  isActive        Boolean  @default(true)
  isFree          Boolean  @default(false)
  
  // Raw API response for future extension
  rawData         Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  
  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([isFree])
  @@map("ai_models")
}

// =====================
// AI Tool Search Cache
// =====================

model SearchCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique  // MD5 hash of query + search_type
  query     String   @db.Text
  searchType String?
  results   Json     // Cached search results
  createdAt DateTime @default(now())
  expiresAt DateTime
  deletedAt DateTime?  // For soft-delete compatibility
  
  @@index([cacheKey])
  @@index([expiresAt])
  @@map("search_cache")
}

model SearchUsageLog {
  id        String   @id @default(uuid())
  month     String   @unique  // "2026-02" format
  count     Int      @default(0)
  limit     Int      @default(1000)  // Monthly limit (Tavily free tier)
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // For soft-delete compatibility
  
  @@map("search_usage_log")
}

// ============================================
// AI Agent 对话会话
// ============================================
model Conversation {
  id          String    @id @default(uuid())
  userId      String
  title       String    @default("New Chat")
  model       String?   // 可选：覆盖用户默认模型
  contextInfo Json?     // 上下文信息快照 { messageCount, totalMessages, contextTokens, maxContextTokens, trimmed }
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  
  @@index([userId, updatedAt])
  @@map("conversations")
}

// ============================================
// AI Agent 消息记录
// ============================================
model Message {
  id              String    @id @default(uuid())
  conversationId  String
  role            String    // 'user' | 'assistant' | 'system' | 'tool'
  content         String    @db.Text
  toolCalls       Json?
  toolCallId      String?
  tokenCount      Int?
  thinkingSteps   Json?     // ReAct 思考步骤 (string[])，持久化保存
  
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?  // 软删除支持
  
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================
// 订阅服务模板
// ============================================
model SubscriptionTemplate {
  id              String   @id @default(uuid())
  name            String   @unique  // "Netflix"
  displayName     String?           // "Netflix 奈飞"
  description     String?  @db.Text // 模板描述
  searchText      String   @db.Text // 搜索关键词
  category        String?
  icon            String?
  website         String?
  pricingPlans    Json?    // { "CN": {...}, "US": {...} }
  defaultCurrency String   @default("CNY")
  defaultCycle    String   @default("monthly")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?  // 软删除支持
  
  @@map("subscription_templates")
}
